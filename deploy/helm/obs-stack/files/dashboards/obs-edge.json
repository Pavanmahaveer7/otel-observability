          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT LogAttributes['method'] AS method, LogAttributes['uri'] AS uri, count() AS requests, round(countIf(LogAttributes['status'] LIKE '5%') * 100 / count(), 2) AS err_5xx_pct, round(quantile(0.95)(toFloat64OrZero(LogAttributes['request_time'])) * 1000, 1) AS p95_ms FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName = 'nginx' AND LogAttributes['status'] != '' GROUP BY method, uri ORDER BY requests DESC LIMIT 20",
