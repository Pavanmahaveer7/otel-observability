          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, LogAttributes['cache'] AS cache, count() / $__interval_s AS rps FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName = 'nginx' AND LogAttributes['status'] != '' AND LogAttributes['uri'] LIKE '/api/catalog%' AND LogAttributes['cache'] != '' GROUP BY time, cache ORDER BY time",
