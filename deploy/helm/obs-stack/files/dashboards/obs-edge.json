          "rawSql": "SELECT if(LogAttributes['scheme'] = 'https', concat('https ', LogAttributes['ssl_protocol']), 'http') AS scheme, count() AS requests FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName = 'nginx' AND LogAttributes['status'] != '' GROUP BY scheme",
