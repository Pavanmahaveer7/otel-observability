    },
    {
      "type": "timeseries",
      "title": "Canary vs stable: p50 latency",
      "id": 15,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, LogAttributes['route'] AS pool, quantile(0.5)(toFloat64OrZero(LogAttributes['request_time'])) * 1000 AS p50_ms FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName = 'nginx' AND LogAttributes['status'] != '' AND LogAttributes['uri'] LIKE '/api/checkout%' AND LogAttributes['route'] != '' GROUP BY time, pool ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
