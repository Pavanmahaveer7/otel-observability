{
  "uid": "obs-edge",
  "title": "Edge - nginx (logs, traces, stub_status)",
  "tags": [
    "otel",
    "nginx",
    "edge",
    "clickhouse"
  ],
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "panels": [
    {
      "type": "row",
      "title": "Traffic and errors (access logs)",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Requests / s by status class",
      "id": 3,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, concat(substring(LogAttributes['status'], 1, 1), 'xx') AS class, count() / $__interval_s AS rps FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName = 'nginx' AND LogAttributes['status'] != '' GROUP BY time, class ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 40,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Error % (4xx, 5xx)",
      "id": 4,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, countIf(LogAttributes['status'] LIKE '4%') * 100 / count() AS `4xx %`, countIf(LogAttributes['status'] LIKE '5%') * 100 / count() AS `5xx %` FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName = 'nginx' AND LogAttributes['status'] != '' GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Latency: user-facing vs backend",
      "id": 5,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "p95 latency: total (request_time) vs upstream",
      "id": 6,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, quantile(0.95)(toFloat64OrZero(LogAttributes['request_time'])) * 1000 AS `total p95`, quantile(0.95)(toFloat64OrZero(LogAttributes['upstream_response_time'])) * 1000 AS `upstream p95`, quantile(0.50)(toFloat64OrZero(LogAttributes['request_time'])) * 1000 AS `total p50` FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName = 'nginx' AND LogAttributes['status'] != '' GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "request_time = what the client saw; upstream_response_time = time waiting on gateway."
    },
    {
      "type": "timeseries",
      "title": "nginx overhead p95 (total - upstream)",
      "id": 7,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, quantile(0.95)(greatest(toFloat64OrZero(LogAttributes['request_time']) - toFloat64OrZero(LogAttributes['upstream_response_time']), 0)) * 1000 AS overhead_ms FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName = 'nginx' AND LogAttributes['status'] != '' GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Time spent in nginx itself: queueing, TLS, buffering. Should stay near zero."
    },
    {
      "type": "row",
      "title": "Connections (stub_status via the nginx receiver)",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "timeseries",
      "title": "Connections by state",
      "id": 9,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time, Attributes['state'] AS state, avg(Value) AS connections FROM otel.otel_metrics_sum WHERE $__timeFilter(TimeUnix) AND MetricName = 'nginx.connections_current' GROUP BY time, state ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Accepted vs handled connections / s, requests / s",
      "id": 10,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT time, metric, greatest(v - lagInFrame(v, 1, v) OVER (PARTITION BY metric ORDER BY time ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), 0) / $__interval_s AS per_s FROM (SELECT $__timeInterval(TimeUnix) AS time, MetricName AS metric, max(Value) AS v FROM otel.otel_metrics_sum WHERE $__timeFilter(TimeUnix) AND MetricName IN ('nginx.connections_accepted', 'nginx.connections_handled', 'nginx.requests') GROUP BY time, metric) ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "accepted > handled means nginx is dropping connections (worker_connections limit)."
    },
    {
      "type": "row",
      "title": "Load balancing, retries, canary",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      }
    },
    {
      "type": "timeseries",
      "title": "Requests / s per gateway pod (least_conn)",
      "id": 12,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, concat(LogAttributes['route'], ' ', LogAttributes['upstream_addr']) AS pod, count() / $__interval_s AS rps FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName = 'nginx' AND LogAttributes['status'] != '' AND LogAttributes['route'] != '' AND LogAttributes['upstream_addr'] NOT LIKE '%,%' AND LogAttributes['upstream_addr'] LIKE '%:%' GROUP BY time, pod ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "nginx resolves the headless Service and balances across individual pods."
    },
    {
      "type": "timeseries",
      "title": "Retried requests / s (tried more than one pod)",
      "id": 13,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, countIf(LogAttributes['upstream_addr'] LIKE '%,%') / $__interval_s AS retries FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName = 'nginx' AND LogAttributes['status'] != '' GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "proxy_next_upstream on connection error / 503. Stays at 0 while pods shut down gracefully."
    },
    {
      "type": "timeseries",
      "title": "Canary vs stable: 5xx %",
      "id": 14,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, LogAttributes['route'] AS pool, countIf(LogAttributes['status'] LIKE '5%') * 100 / count() AS err_pct FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND ServiceName = 'nginx' AND LogAttributes['status'] != '' AND LogAttributes['uri'] LIKE '/api/checkout%' AND LogAttributes['route'] != '' GROUP BY time, pool ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
