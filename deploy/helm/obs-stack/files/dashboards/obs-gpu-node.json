      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Attributes['gpu'] AS gpu, Value AS xid, max(TimeUnix) AS last_seen, count() AS samples FROM ${database}.otel_metrics_gauge WHERE $__timeFilter(TimeUnix) AND MetricName = 'DCGM_FI_DEV_XID_ERRORS' AND Value > 0 GROUP BY gpu, xid ORDER BY last_seen DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Last XID per GPU. 48/63/64/74/79/94/95 are the ones that usually need a ticket."
    },
    {
      "type": "table",
      "title": "ECC & row remapping (latest)",
      "id": 14,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 35
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Attributes['gpu'] AS gpu, argMaxIf(Value, TimeUnix, MetricName LIKE 'DCGM_FI_DEV_ECC_SBE_VOL_TOTAL%') AS ecc_sbe, argMaxIf(Value, TimeUnix, MetricName LIKE 'DCGM_FI_DEV_ECC_DBE_VOL_TOTAL%') AS ecc_dbe, argMaxIf(Value, TimeUnix, MetricName LIKE 'DCGM_FI_DEV_CORRECTABLE_REMAPPED_ROWS%') AS remap_corr, argMaxIf(Value, TimeUnix, MetricName LIKE 'DCGM_FI_DEV_UNCORRECTABLE_REMAPPED_ROWS%') AS remap_uncorr, argMaxIf(Value, TimeUnix, MetricName LIKE 'DCGM_FI_DEV_ROW_REMAP_FAILURE%') AS remap_fail, argMaxIf(Value, TimeUnix, MetricName LIKE 'DCGM_FI_DEV_PCIE_REPLAY_COUNTER%') AS pcie_replays FROM merge('${database}', '^otel_metrics_(gauge|sum)$') WHERE $__timeFilter(TimeUnix) AND MetricName LIKE 'DCGM_FI_DEV_%' GROUP BY gpu ORDER BY toUInt32OrZero(gpu)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
