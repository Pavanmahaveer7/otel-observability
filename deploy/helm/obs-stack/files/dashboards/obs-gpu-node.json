          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time, concat('GPU ', Attributes['gpu']) AS series, sum(Value) * 1 AS value FROM ${database}.otel_metrics_gauge WHERE $__timeFilter(TimeUnix) AND MetricName IN ('DCGM_FI_PROF_NVLINK_TX_BYTES', 'DCGM_FI_PROF_NVLINK_RX_BYTES') GROUP BY time, series ORDER BY time",
