          "rawSql": "SELECT Attributes['mountpoint'] AS mount, Attributes['device'] AS device, Attributes['fstype'] AS fstype, round(argMaxIf(Value, TimeUnix, MetricName = 'node_filesystem_size_bytes') / 1e9, 1) AS size_gb, round(argMaxIf(Value, TimeUnix, MetricName = 'node_filesystem_avail_bytes') / 1e9, 1) AS avail_gb, round(100 * (1 - avail_gb / greatest(size_gb, 0.001)), 1) AS used_pct FROM ${database}.otel_metrics_gauge WHERE $__timeFilter(TimeUnix) AND MetricName IN ('node_filesystem_size_bytes', 'node_filesystem_avail_bytes') AND Attributes['fstype'] NOT IN ('tmpfs', 'overlay', 'squashfs') GROUP BY mount, device, fstype ORDER BY size_gb DESC",
