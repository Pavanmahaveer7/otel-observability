    {
      "type": "timeseries",
      "title": "InfiniBand / RoCE port throughput",
      "id": 10,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT time, series, greatest(v - lagInFrame(v, 1, v) OVER (PARTITION BY series ORDER BY time ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), 0) / $__interval_s * 1 AS value FROM (SELECT $__timeInterval(TimeUnix) AS time, concat(Attributes['device'], ':', Attributes['port'], ' ', if(MetricName LIKE '%received%', 'rx', 'tx')) AS series, max(Value) AS v FROM ${database}.otel_metrics_sum WHERE $__timeFilter(TimeUnix) AND MetricName IN ('node_infiniband_port_data_received_bytes', 'node_infiniband_port_data_received_bytes_total', 'node_infiniband_port_data_transmitted_bytes', 'node_infiniband_port_data_transmitted_bytes_total') GROUP BY time, series) ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Empty if the node has no HCAs (common on single-node instances)."
    },
    {
      "type": "table",
      "title": "InfiniBand port errors (window)",
      "id": 11,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Attributes['device'] AS device, Attributes['port'] AS port, replaceRegexpOne(MetricName, '^node_infiniband_|_total$', '') AS counter, max(Value) - min(Value) AS increase FROM ${database}.otel_metrics_sum WHERE $__timeFilter(TimeUnix) AND MetricName IN ('node_infiniband_link_downed', 'node_infiniband_link_downed_total', 'node_infiniband_link_error_recovery', 'node_infiniband_link_error_recovery_total', 'node_infiniband_port_errors_received', 'node_infiniband_port_errors_received_total', 'node_infiniband_symbol_error', 'node_infiniband_symbol_error_total', 'node_infiniband_port_transmit_wait', 'node_infiniband_port_transmit_wait_total') GROUP BY device, port, counter ORDER BY increase DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
