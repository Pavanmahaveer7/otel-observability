          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time, ResourceAttributes['host.name'] AS host, 100 * avgIf(Value, Attributes['state'] = 'used') AS used_pct FROM otel.otel_metrics_gauge WHERE $__timeFilter(TimeUnix) AND MetricName = 'system.memory.utilization' GROUP BY time, host ORDER BY time",
          "refId": "A"
