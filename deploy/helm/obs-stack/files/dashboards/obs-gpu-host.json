    {
      "type": "table",
      "title": "Filesystem usage (latest)",
      "id": 14,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT ResourceAttributes['host.name'] AS host, Attributes['mountpoint'] AS mount, round(100 * argMax(Value, TimeUnix), 1) AS used_pct FROM otel.otel_metrics_gauge WHERE $__timeFilter(TimeUnix) AND MetricName = 'system.filesystem.utilization' GROUP BY host, mount ORDER BY used_pct DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Network throughput by host (Prometheus)",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host_name, network_io_direction) (rate(system_network_io_bytes_total[2m]))",
          "legendFormat": "{{host_name}} {{network_io_direction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
