{
  "uid": "obs-k8s",
  "title": "Kubernetes - minikube (ClickHouse)",
  "tags": [
    "otel",
    "k8s",
    "clickhouse"
  ],
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "panels": [
    {
      "type": "row",
      "title": "Cluster state (k8s_cluster receiver)",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Nodes ready",
      "id": 3,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sum(v) AS value FROM (SELECT ResourceAttributes['k8s.node.name'] AS n, argMax(Value, TimeUnix) AS v FROM otel.otel_metrics_gauge WHERE $__timeFilter(TimeUnix) AND MetricName = 'k8s.node.condition_ready' GROUP BY n)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Pods running",
      "id": 4,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT countIf(v = 2) AS value FROM (SELECT ResourceAttributes['k8s.pod.uid'] AS p, argMax(Value, TimeUnix) AS v FROM otel.otel_metrics_gauge WHERE $__timeFilter(TimeUnix) AND MetricName = 'k8s.pod.phase' AND ResourceAttributes['k8s.namespace.name'] IN (${namespace:singlequote}) AND TimeUnix > now() - INTERVAL 2 MINUTE GROUP BY p)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Pods not running",
      "id": 5,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT countIf(v != 2 AND v != 3) AS value FROM (SELECT ResourceAttributes['k8s.pod.uid'] AS p, argMax(Value, TimeUnix) AS v FROM otel.otel_metrics_gauge WHERE $__timeFilter(TimeUnix) AND MetricName = 'k8s.pod.phase' AND ResourceAttributes['k8s.namespace.name'] IN (${namespace:singlequote}) AND TimeUnix > now() - INTERVAL 2 MINUTE GROUP BY p)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "stat",
      "title": "Container restarts (window)",
      "id": 6,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sum(d) AS value FROM (SELECT ResourceAttributes['k8s.pod.uid'] AS p, ResourceAttributes['k8s.container.name'] AS c, max(Value) - min(Value) AS d FROM otel.otel_metrics_gauge WHERE $__timeFilter(TimeUnix) AND MetricName = 'k8s.container.restarts' AND ResourceAttributes['k8s.namespace.name'] IN (${namespace:singlequote}) GROUP BY p, c)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "table",
      "title": "Deployments",
      "id": 7,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT ResourceAttributes['k8s.namespace.name'] AS namespace, ResourceAttributes['k8s.deployment.name'] AS deployment, argMaxIf(Value, TimeUnix, MetricName = 'k8s.deployment.desired') AS desired, argMaxIf(Value, TimeUnix, MetricName = 'k8s.deployment.available') AS available FROM otel.otel_metrics_gauge WHERE $__timeFilter(TimeUnix) AND MetricName IN ('k8s.deployment.desired', 'k8s.deployment.available') AND ResourceAttributes['k8s.namespace.name'] IN (${namespace:singlequote}) GROUP BY namespace, deployment ORDER BY namespace, deployment",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Resource usage (kubeletstats receiver)",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      }
    },
    {
      "type": "timeseries",
      "title": "Pod CPU (cores)",
      "id": 9,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time, ResourceAttributes['k8s.pod.name'] AS pod, avg(Value) AS cores FROM otel.otel_metrics_gauge WHERE $__timeFilter(TimeUnix) AND MetricName IN ('k8s.pod.cpu.usage', 'k8s.pod.cpu.utilization') AND ResourceAttributes['k8s.namespace.name'] IN (${namespace:singlequote}) GROUP BY time, pod ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Pod memory working set",
      "id": 10,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time, ResourceAttributes['k8s.pod.name'] AS pod, avg(Value) AS bytes FROM otel.otel_metrics_gauge WHERE $__timeFilter(TimeUnix) AND MetricName = 'k8s.pod.memory.working_set' AND ResourceAttributes['k8s.namespace.name'] IN (${namespace:singlequote}) GROUP BY time, pod ORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Node CPU (cores) and memory",
      "id": 11,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time, 'cpu cores' AS metric, avg(Value) AS value FROM otel.otel_metrics_gauge WHERE $__timeFilter(TimeUnix) AND MetricName IN ('k8s.node.cpu.usage', 'k8s.node.cpu.utilization') GROUP BY time ORDER BY time",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time, 'memory GiB' AS metric, avg(Value) / 1073741824 AS value FROM otel.otel_metrics_gauge WHERE $__timeFilter(TimeUnix) AND MetricName = 'k8s.node.memory.working_set' GROUP BY time ORDER BY time",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "title": "Events and container logs",
      "id": 12,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      }
    },
    {
      "type": "table",
      "title": "Kubernetes events (k8sobjects receiver)",
      "id": 13,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Timestamp AS time, JSONExtractString(Body, 'object', 'type') AS type, JSONExtractString(Body, 'object', 'reason') AS reason, JSONExtractString(Body, 'object', 'regarding', 'kind') AS kind, JSONExtractString(Body, 'object', 'regarding', 'namespace') AS namespace, JSONExtractString(Body, 'object', 'regarding', 'name') AS object, JSONExtractString(Body, 'object', 'note') AS note FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND LogAttributes['event.domain'] = 'k8s' ORDER BY Timestamp DESC LIMIT 200",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "logs",
      "title": "Container logs (filelog receiver)",
      "id": 14,
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 2,
          "queryType": "logs",
          "rawSql": "SELECT Timestamp AS timestamp, Body AS body, SeverityText AS level, ResourceAttributes['k8s.pod.name'] AS pod, ResourceAttributes['k8s.container.name'] AS container FROM otel.otel_logs WHERE $__timeFilter(Timestamp) AND LogAttributes['log.iostream'] != '' AND ResourceAttributes['k8s.namespace.name'] IN (${namespace:singlequote}) ORDER BY Timestamp DESC LIMIT 300",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "query": "SELECT DISTINCT ResourceAttributes['k8s.namespace.name'] FROM otel.otel_metrics_gauge WHERE MetricName LIKE 'k8s.pod.%' AND TimeUnix > now() - INTERVAL 1 HOUR",
        "definition": "\n    SELECT DISTINCT ResourceAttributes['k8s.namespace.name'] FROM otel.otel_metrics_gauge\n    WHERE MetricName LIKE 'k8s.pod.%' AND TimeUnix > now() - INTERVAL 1 HOUR",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
